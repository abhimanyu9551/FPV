{
  "name": "fpv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @fpv/database run generate",
    "db:migrate": "pnpm --filter @fpv/database run migrate",
    "db:push": "pnpm --filter @fpv/database run push",
    "db:seed": "pnpm --filter @fpv/database run seed",
    "db:studio": "pnpm --filter @fpv/database run studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@react-navigation/native>react": "19",
        "@react-navigation/core>react": "19",
        "@react-navigation/bottom-tabs>react": "19",
        "@react-navigation/elements>react": "19",
        "@react-navigation/native-stack>react": "19"
      }
    }
  }
}
