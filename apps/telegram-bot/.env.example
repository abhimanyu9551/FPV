# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Authorized Telegram user IDs (comma-separated, no spaces)
# Get your user ID by messaging @userinfobot on Telegram
AUTHORIZED_USER_IDS=12345678,87654321

# Finance Dashboard API base URL
# When running dashboard locally: http://localhost:3000
# When using Cloudflare Tunnel: https://your-tunnel.cfargotunnel.com
FINANCE_API_BASE_URL=http://localhost:3000

# API auth token for internal bot requests
# Set this in dashboard .env.local as BOT_API_SECRET and match here
BOT_API_SECRET=change-me-to-a-random-secret-string

# Logging
LOG_LEVEL=INFO
